    MemoryStrands >= 1
    Rarity <= Rare
    Corrupted False
    Mirrored False
    SetFontSize 42
    SetTextColor 255 255 255 255
    SetBorderColor 212 175 55 255
    SetBackgroundColor 42 35 11 255
    PlayEffect Orange
    MinimapIcon 1 Orange Diamond


