    Rarity Magic Rare
    Identified True
    HasExplicitMod "Gazelle's" "Cheetah's" "Hellion's"
    AreaLevel <= 67
    ItemLevel <= 72
    SetFontSize 40
    SetBorderColor 100 144 71 255
    SetBackgroundColor 10 12 8 255
    PlayAlertSound 2 300


