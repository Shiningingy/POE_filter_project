#==[00000]-自定义规则==
# 在此添加自定义规则将会覆盖所有过滤器设定.


#===================================================================================================================
# [[10000]] 装备 Equipment
#===================================================================================================================

#==[11000]-装备 Equipment - VendorRecipes VendorRecipes - 机会底材 Chancing Bases==

#==[11001]- Chancing Bases -机会目标（普通品质） 机会底材 - 自动音效：Opal Ring - 精确==
Show
    BaseType == "Opal Ring"
    Rarity Normal
    SetFontSize 40
    SetTextColor 234 206 200 255
    SetBorderColor 216 166 156 255
    SetBackgroundColor 140 68 54 255
    CustomAlertSound "Sharket掉落音效\蛋白石戒指.mp3" 200


#==[11002]- Chancing Bases -机会目标（普通品质） 机会底材 - 基础 - 精确==
Show
    BaseType == "Assassin's Garb" "Brine Crown" "Death's Hand" "Harbinger Bow" "Imperial Bow" "Murder Mitts" "Occultist's Vestment" "Two-Stone Ring" "Vaal Regalia"
    Rarity Normal
    SetFontSize 40
    SetTextColor 234 206 200 255
    SetBorderColor 216 166 156 255
    SetBackgroundColor 140 68 54 255
    PlayAlertSound 1 300


#==[12000]-装备 Equipment - VendorRecipes VendorRecipes - 洞&色&连 Sockets Colors Links==

#==[12001]- Sockets Colors Links -六连 洞&色&连 - Class Condition==
Show
    Class "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bows" "Wands" "Claws" "Daggers" "Rune Daggers" "Sceptres" "Staves" "Warstaves" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Thrusting One Hand Swords" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords"
    LinkedSockets >= 6
    Rarity <= Rare
    SetFontSize 45
    SetTextColor 111 97 42 255
    SetBorderColor 150 135 74 255
    SetBackgroundColor 248 248 242 255
    PlayAlertSound 6 300
    PlayEffect White
    MinimapIcon 0 White Star


#==[12002]- Sockets Colors Links -六孔 洞&色&连 - Class Condition==
Show
    Class "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bows" "Wands" "Claws" "Daggers" "Rune Daggers" "Sceptres" "Staves" "Warstaves" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Thrusting One Hand Swords" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords"
    Sockets >= 6
    Rarity <= Rare
    SetFontSize 40
    SetTextColor 255 255 255 255
    SetBorderColor 220 212 183 255
    SetBackgroundColor 130 117 64 255
    PlayAlertSound 2 300


#==[12003]- Sockets Colors Links -三色相连 洞&色&连 - Class Condition==
Show
    Class "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bows" "Wands" "Claws" "Daggers" "Rune Daggers" "Sceptres" "Staves" "Warstaves" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Thrusting One Hand Swords" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords"
    SocketGroup RGB
    Rarity <= Rare
    SetFontSize 40
    SetTextColor 213 199 144 255
    SetBorderColor 0 0 0 0
    SetBackgroundColor 51 46 25 255


