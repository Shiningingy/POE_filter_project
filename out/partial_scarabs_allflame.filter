    BaseType == "Enshrouded Body Armour" "Enshrouded Boots" "Enshrouded Gloves" "Enshrouded Helmet" "Enshrouded Shield"
    SetFontSize 39
    SetTextColor 218 187 85 255
    SetBorderColor 212 175 55 255
    SetBackgroundColor 16 16 22 255
    PlayAlertSound 2 300
    MinimapIcon 1 Orange Circle

#==[42000]-Curse of the Allflame Curse of the Allflame - 可堆叠通货 Curse of the Allflame==


